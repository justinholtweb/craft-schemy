{% extends '_layouts/cp' %}
{% import '_includes/forms' as forms %}

{% set title = 'Settings'|t('app') %}
{% set selectedSubnavItem = 'settings' %}
{% set fullPageForm = not readOnly %}

{% block content %}
    {% include 'schemy/_includes/readonly' %}

    {{ actionInput('schemy/settings/save-general') }}
    {{ redirectInput('schemy/settings') }}

    {{ forms.lightswitchField({
        label: 'Output automatically'|t('schemy'),
        instructions: 'Add JSON-LD to the `<head>` of every front-end page. Turn this off to place `{{ craft.schemy.render() }}` in your templates yourself.'|t('schemy'),
        name: 'autoInject',
        on: settings.autoInject,
    }) }}

    {{ forms.lightswitchField({
        label: 'Include site identity'|t('schemy'),
        instructions: 'Output the Organization/Person node configured under Site Identity.'|t('schemy'),
        name: 'includeIdentity',
        on: settings.includeIdentity,
    }) }}

    {{ forms.lightswitchField({
        label: 'Include WebSite'|t('schemy'),
        instructions: 'Output a WebSite node for the current site.'|t('schemy'),
        name: 'includeWebSite',
        on: settings.includeWebSite,
    }) }}

    {{ forms.lightswitchField({
        label: 'Include breadcrumbs'|t('schemy'),
        instructions: 'Output a BreadcrumbList built from the site home page and, in structure sections, the entry’s ancestors.'|t('schemy'),
        name: 'includeBreadcrumbs',
        on: settings.includeBreadcrumbs,
    }) }}

    <hr>

    <h2>{{ 'Control Panel'|t('app') }}</h2>
    <p class="light">{{ 'How Schemy appears in the sidebar. An override set in Settings → Control Panel Navigation takes precedence over these.'|t('schemy') }}</p>

    {{ forms.textField({
        label: 'Sidebar label'|t('schemy'),
        instructions: 'Leave empty for “Schemy”.'|t('schemy'),
        id: 'navLabel',
        name: 'navLabel',
        value: settings.navLabel,
        placeholder: 'Schemy',
        maxlength: 64,
        errors: settings.getErrors('navLabel'),
    }) }}

    {{ forms.iconPickerField({
        label: 'Sidebar icon'|t('schemy'),
        instructions: 'Leave empty for Schemy’s own icon.'|t('schemy'),
        id: 'navIcon',
        name: 'navIcon',
        value: settings.navIcon,
        errors: settings.getErrors('navIcon'),
    }) }}

    {{ forms.textareaField({
        label: 'Custom SVG icon'|t('schemy'),
        instructions: 'Optional. Paste one `<svg>` element to use instead of the icon above. It’s sanitized every time it’s drawn; a single-color icon using `currentColor` matches the rest of the sidebar.'|t('schemy'),
        id: 'navIconSvg',
        name: 'navIconSvg',
        value: settings.navIconSvg,
        rows: 4,
        class: 'code',
        errors: settings.getErrors('navIconSvg'),
    }) }}
{% endblock %}
