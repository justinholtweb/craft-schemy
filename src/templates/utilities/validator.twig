{% import '_includes/forms' as forms %}

<div id="{{ id }}" class="schemy-validator">
    <p class="light">
        {{ 'Checks JSON-LD for broken structure, likely typos, badly formed dates and URLs, and properties that Google’s rich results need. It runs on this server and sends nothing anywhere. Google’s Rich Results Test is still the final word.'|t('schemy') }}
    </p>

    {{ forms.elementSelectField({
        label: 'Entry'|t('app'),
        instructions: 'Validate what Schemy outputs for an entry.'|t('schemy'),
        id: id ~ '-entry',
        name: 'entryId',
        elementType: 'craft\\elements\\Entry',
        limit: 1,
        showSiteMenu: true,
        criteria: {status: null},
    }) }}

    {{ forms.textareaField({
        label: 'Or paste JSON-LD'|t('schemy'),
        instructions: 'Used when no entry is selected. A `<script>` tag around the JSON is fine.'|t('schemy'),
        id: id ~ '-json',
        name: 'json',
        rows: 10,
        class: 'code',
        placeholder: '{"@context": "https://schema.org", "@type": "Article", …}',
    }) }}

    <div class="buttons">
        <button type="button" class="btn submit" data-schemy-validate>{{ 'Validate'|t('schemy') }}</button>
        <div class="spinner" data-schemy-spinner hidden></div>
    </div>

    <div data-schemy-results hidden>
        <hr>
        <h2 data-schemy-summary-heading></h2>
        <table class="data fullwidth schemy-issues" data-schemy-issues hidden>
            <thead>
                <tr>
                    <th scope="col">{{ 'Severity'|t('schemy') }}</th>
                    <th scope="col">{{ 'Where'|t('schemy') }}</th>
                    <th scope="col">{{ 'Issue'|t('schemy') }}</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
        <details class="schemy-validator-json" data-schemy-json-wrapper hidden>
            <summary>{{ 'JSON-LD'|t('schemy') }}</summary>
            <pre class="schemy-preview-output code" data-schemy-json></pre>
        </details>
    </div>
</div>

{% js %}
    Schemy.initValidator({{ id|json_encode|raw }});
{% endjs %}
